    way  212      footway bicycle=designated               -> included
    way  213      pedestrian bicycle=yes                   -> included
    way  214      pedestrian without bicycle tag           -> EXCLUDED
    way  215      track (no bicycle tag)                   -> included
    way  216      living_street                            -> included
    way  217      residential + bicycle_road=yes           -> included
    node 301      highway=traffic_signals                  -> control pseudo-way
    node 302      highway=stop                             -> control pseudo-way
    node 303      highway=crossing                         -> EXCLUDED
-->
